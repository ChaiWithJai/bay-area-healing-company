# Cloud providers — set whichever you plan to use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local provider (ollama) — only needed if it's not on the default localhost port.
OLLAMA_HOST=http://127.0.0.1:11434

# Optional: which provider `wm workflow run` uses when --provider is omitted.
WM_DEFAULT_PROVIDER=anthropic
