# Environment variables are read from the process environment.
# This file is documentation; wm does not automatically load .env files.

# Local Ollama server. Only HTTP loopback addresses are permitted.
OLLAMA_HOST=http://127.0.0.1:11434

# Configured profile name, not a model download request.
WM_DEFAULT_PROVIDER=bonsai8

# Set to your prepared Python interpreter with requirements.txt installed.
# In Codex, use the Python path returned by load_workspace_dependencies.
# WM_PYTHON=/absolute/path/to/python3

# Optional isolated state directory, resolved relative to the current directory.
# WM_STATE_DIR=./.wm

# No cloud API keys or Codex runtime credentials are used.
